#!/bin/sh
# =============================================================================
# mvnw - simple Maven Wrapper launcher script (POSIX shell)
#
# Lightweight, curriculum-friendly stand-in for the full Maven Wrapper
# generated by "mvn -N wrapper:wrapper". It delegates every argument to a
# Maven installation already available on PATH, so the README's
# "./mvnw ..." instructions work out of the box. For the official,
# checksum-verified wrapper (which downloads a pinned Maven distribution),
# run `mvn -N wrapper:wrapper` once you have any Maven version installed.
# =============================================================================
set -e

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

echo "Error: Apache Maven ('mvn') was not found on your PATH." >&2
echo "Install Maven (https://maven.apache.org/install.html) and try again." >&2
exit 1
