<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven POM for the "service-registry" module: a Netflix Eureka server that
  every other microservice registers itself with and queries to discover
  peer services by logical name instead of hardcoded host:port pairs.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.blogcode</groupId>
        <artifactId>microservices-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>service-registry</artifactId>
    <packaging>jar</packaging>
    <name>service-registry</name>
    <description>Eureka service discovery server for the microservices curriculum module.</description>

    <dependencies>
        <!--
          spring-cloud-starter-netflix-eureka-server turns this plain Spring
          Boot application into a Eureka registry once @EnableEurekaServer
          is added to the main class.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>

        <!--
          spring-boot-starter-webmvc supplies the embedded servlet container
          and Spring MVC that the Eureka dashboard/REST API run on.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>service-registry</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
